{{- /* 搜索索引：只收博客文章，Sparks 碎碎念和独立页面都不进索引 */ -}}
{{- $.Scratch.Add "index" slice -}}
{{- range where .Site.RegularPages "Section" "blog" -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "date" (.Date.Format "2006-01-02") "permalink" .Permalink "content" .Plain "tags" .Params.tags) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
